---
import { Font } from "astro:assets";
import "../styles/global.css";

import Analytics from "@vercel/analytics/astro";
import ExternalLink from "../components/shared/ExternalLink.astro";

const { canonical, description, title } = Astro.props;

const pageTitle = title
	? `${title} | Thomas Malinovsky's Blog`
	: "Thomas Malinovsky's Blog";

const pageDescription = description ?? "Thomas Malinovsky's Blog";

const isABlogPage = !!title;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>

		<meta name="description" content={pageDescription} />
		<meta name="author" content="Thomas Malinovsky" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#31372b" />

		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="article" />
		<meta property="og:site_name" content="Thomas Malinovsky" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta
			property="og:image"
			content="https://malinovsky.dev/favicon.png"
		/>

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:creator" content="@ImDarkTom" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta
			name="twitter:image"
			content="https://malinovsky.dev/favicon.png"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="mask-icon" href="/favicon.svg" color="#e4d7ab" />

		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-inter" preload />
		<Analytics />
	</head>
	<body class="bg-olive-900 text-cream-100 flex flex-col">
		<header
			class="mx-auto w-full max-w-prose px-4 p-8 flex flex-row justify-between"
		>
			{
				isABlogPage ? (
					<a href="/blog" class="hover:underline">
						← All Blogs
					</a>
				) : (
					<a href="/" class="hover:underline">
						← Home
					</a>
				)
			}
		</header>
		<main class="grow mx-auto w-full max-w-prose">
			<slot />
		</main>
		<footer class="py-4 mt-auto mx-auto w-full max-w-prose text-olive-300">
			{
				isABlogPage ? (
					<span class="text-sm">
						Reply via:&nbsp;
						<a
							class="underline"
							href={`mailto:thomas+blog@malinovsky.dev?subject=Re: ${canonical}`}
						>
							Email
						</a>
					</span>
				) : (
					<span class="text-sm">
						Inspired by:
						<ExternalLink
							href="https://blog.jim-nielsen.com/"
							class="underline"
						>
							Jim Nielsen's Blog
						</ExternalLink>
					</span>
				)
			}
		</footer>
	</body>
</html>
