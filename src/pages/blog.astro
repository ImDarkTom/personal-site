---
import { getCollection } from "astro:content";
import LayoutBlog from "../layouts/LayoutBlog.astro";
const posts = await getCollection("blog");
---

<LayoutBlog>
    <h1>Thomas Malinovsky's Blog</h1>
    <ul>
        {
        posts.map((post: any) => (
            <li>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
        ))
        }
    </ul>
</LayoutBlog>
