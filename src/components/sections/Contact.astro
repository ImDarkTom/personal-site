---
import { Icon } from "astro-icon/components";
import ExternalLink from "../shared/ExternalLink.astro";
---

<section id="contact" class="w-full pb-40 pt-4">
    <h2 class="text-xl font-medium">Contact</h2>

    <p>
        I'm currently in college studying computing and am open to summer
        internships, freelance work, or any interesting projects to build. The
        best way to contact me is via email.
    </p>

    <div class="inline-flex flex-wrap gap-2 mt-4" id="contact-items">
        <a href="mailto:thomas@malinovsky.dev">
            <Icon name="mdi:email-outline" />
            <span>thomas@malinovsky.dev</span>
        </a>

        <ExternalLink href="https://github.com/ImDarkTom">
            <Icon name="mdi:github" />
            <span>GitHub</span>
        </ExternalLink>

        <ExternalLink href="https://www.linkedin.com/in/thomasmalinovsky/">
            <Icon name="mdi:linkedin" />
            <span>LinkedIn</span>
        </ExternalLink>
    </div>
</section>

<style>
    @reference "../../styles/global.css";

    #contact-items a {
        @apply bg-olive-800 flex flex-row gap-2 items-center text-sm py-1.5 px-2 rounded-lg ring ring-olive-700 ring-inset select-none hover:bg-olive-700 transition-colors duration-200;
    }
</style>
