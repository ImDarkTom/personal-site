{
    "redirects": [
        {
            "source": "/blog/:path*",
            "has": [{ "type": "host", "value": "malinovsky.dev" }],
            "destination": "https://blog.malinovsky.dev/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "has": [{ "type": "host", "value": "blog.malinovsky.dev" }],
            "destination": "/blog/"
        },
        {
            "source": "/:path((?!_astro/|_vercel/|favicon|robots.txt|sitemap.xml).*)",
            "has": [{ "type": "host", "value": "blog.malinovsky.dev" }],
            "destination": "/blog/:path"
        }
    ]
}
